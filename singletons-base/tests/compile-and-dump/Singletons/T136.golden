      Pred_Binary_3 '[] = Apply ErrorSym0 "pred 0"
      Pred_Binary_3 ('(:) 'False as) = Apply (Apply (:@#@$) TrueSym0) (Apply PredSym0 as)
      Pred_Binary_3 ('(:) 'True as) = Apply (Apply (:@#@$) FalseSym0) as
