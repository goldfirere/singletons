    type family Succ_Binary_1 (a :: [Bool]) :: [Bool] where
      Succ_Binary_1 '[] = Apply (Apply (:@#@$) TrueSym0) NilSym0
      Succ_Binary_1 ('(:) 'False as) = Apply (Apply (:@#@$) TrueSym0) as
      Succ_Binary_1 ('(:) 'True as) = Apply (Apply (:@#@$) FalseSym0) (Apply SuccSym0 as)
